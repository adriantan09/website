# Copy this file to `.env.local` and fill in your Sanity project values.
# .env.local is gitignored and should never be committed.
#
# Find your project ID in https://www.sanity.io/manage > your project > API.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public site URL (no trailing slash). Used by Sanity Studio's Presentation
# tool to know where to load preview iframes from. Locally this is
# http://localhost:3000; in production it's your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Draft Mode + Webhook Revalidation ---
#
# Required for the "Open Preview" workflow and instant cache invalidation
# on publish. Generate the read token at:
#   https://www.sanity.io/manage > your project > API > Tokens
#   Add API token > role: Viewer (or Editor) > copy the token here.
#
# The two _SECRET values are arbitrary strings you choose yourself — they
# just need to match between this env file and the corresponding webhook
# config in sanity.io/manage. Use long random strings (e.g. `openssl rand
# -hex 32`).

SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=
